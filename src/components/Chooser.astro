---
/**
 * Página temporal para comparar las dos variantes visuales antes de elegir.
 * Se elimina junto con la variante descartada.
 */
import Base from '@/layouts/Base.astro';
import { getProfile } from '@/lib/content';
import { localePath, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = await getProfile(locale);
const es = locale === 'es';
const variants = [
  {
    id: 'blueprint',
    name: 'Blueprint',
    tagline: es
      ? 'Plano técnico: la trayectoria dibujada como una ruta de integración (EIP).'
      : 'Technical drawing: the career drawn as an Enterprise Integration route.',
  },
  {
    id: 'script',
    name: 'Script',
    tagline: es
      ? 'Guion a tres voces: el arquitecto, el constructor, el líder.'
      : 'A working script in three voices: the architect, the builder, the leader.',
  },
];
---

<Base
  {locale}
  {profile}
  path="/"
  title={`${profile.shortName} · ${es ? 'Elegir variante' : 'Choose a variant'}`}
  description={profile.tagline}
>
  <main id="main" class="chooser">
    <p class="chooser__note">
      {es ? 'Vista previa temporal. Elegí una variante:' : 'Temporary preview. Pick a variant:'}
    </p>
    <h1>{profile.shortName}</h1>
    <ul role="list" class="chooser__list">
      {
        variants.map((v) => (
          <li>
            <a href={localePath(locale, v.id)}>
              <strong>{v.name}</strong>
              <span>{v.tagline}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="chooser__lang">
      <a href={localePath(es ? 'en' : 'es', '/')}>{es ? 'English' : 'Español'}</a>
    </p>
  </main>
</Base>

<style>
  .chooser {
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 1.25rem;
    font-family: system-ui, sans-serif;
    color: #151515;
  }
  .chooser__note {
    font-size: 0.875rem;
    color: #4a4f55;
    margin-bottom: 0.5rem;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }
  .chooser__list {
    display: grid;
    gap: 1rem;
  }
  .chooser__list a {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem;
    border: 1px solid #151515;
    text-decoration: none;
  }
  .chooser__list a:hover,
  .chooser__list a:focus-visible {
    background: #151515;
    color: #fafaf7;
  }
  .chooser__lang {
    margin-top: 2rem;
  }
</style>
