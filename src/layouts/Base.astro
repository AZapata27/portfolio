---
/**
 * Esqueleto HTML común a todas las variantes: head, SEO, estilos globales y
 * un slot `head` para que cada variante inyecte sus fuentes (`<Font />`) y tokens.
 * La identidad visual NO vive aquí; vive en `src/variants/<variante>/`.
 */
import '@/styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Seo from '@/components/Seo.astro';
import { t, type Locale } from '@/lib/i18n';
import type { Profile } from '@/lib/content';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  profile: Profile;
  /** Atributo `data-variant` en <html>, para que los tokens de la variante apliquen. */
  variant?: string;
  bodyClass?: string;
  /** Imagen Open Graph de la página (por defecto `/og.png`). */
  image?: string;
  /** Rutas localizadas cuando el segmento cambia por idioma (ver `Seo.astro`). */
  paths?: Partial<Record<Locale, string>>;
}

const { locale, title, description, path, profile, variant, bodyClass, image, paths } = Astro.props;
const tr = t(locale);
---

<!doctype html>
<html lang={locale} data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light" />
    <Seo {locale} {title} {description} {path} {profile} {image} {paths} />
    <slot name="head" />
    {/* Analítica sin cookies de Vercel (vistas de página) y Speed Insights (experiencia real); ver docs/ANALITICA.md */}
    <Analytics />
    <SpeedInsights />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{tr('skip')}</a>
    <slot />
  </body>
</html>
