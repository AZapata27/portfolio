---
import Base from '@/layouts/Base.astro';
import { getProfile } from '@/lib/content';

const profile = await getProfile('en');
---

<Base locale="en" {profile} path="/404" title="Not found · Andrés Zapata" description={profile.tagline}>
  <main id="main" class="nf">
    <p class="nf__code">404</p>
    <h1>This route has no outbound endpoint.</h1>
    <p><a href="/">Back to the start</a> · <a href="/es/">Volver al inicio</a></p>
  </main>
</Base>

<style>
  .nf {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    gap: 0.75rem;
    padding: 2rem 1.25rem;
    font-family: system-ui, sans-serif;
    color: #151515;
    text-align: center;
  }
  .nf__code {
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: #4a4f55;
  }
  h1 {
    font-size: 1.5rem;
  }
</style>
