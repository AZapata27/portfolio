---
/**
 * Sprite con los símbolos EIP dibujados a mano (canal, router por contenido,
 * agregador, endpoint, sobre del mensaje, control bus) y los tres glifos de rama.
 *
 * Mismo trazo que `src/components/Icon.astro` (24×24, stroke 1.75, remates
 * redondos). Se incluye una vez por página; el diagrama SVG y la versión móvil
 * lo reutilizan con `<use href="#eip-…" />`, así los dos dibujos comparten iconos.
 */
---

<svg class="eip-sprite" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="eip-channel" viewBox="0 0 24 24">
      <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 7h11a3 5 0 0 1 0 10H6" />
        <ellipse cx="6" cy="12" rx="3" ry="5" />
      </g>
    </symbol>
    <symbol id="eip-router" viewBox="0 0 24 24">
      <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12h7M10 12l8-7M10 12h8M10 12l8 7" />
      </g>
    </symbol>
    <symbol id="eip-aggregator" viewBox="0 0 24 24">
      <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 5l8 7M6 12h8M6 19l8-7M14 12h7" />
      </g>
    </symbol>
    <symbol id="eip-endpoint" viewBox="0 0 24 24">
      <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="7" width="11" height="10" />
        <rect x="14" y="9.5" width="7" height="5" />
      </g>
    </symbol>
    <symbol id="eip-envelope" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="6" width="18" height="12" fill="var(--amber)" />
        <path d="m3 7 9 6 9-6" fill="none" />
      </g>
    </symbol>
    <symbol id="eip-bus" viewBox="0 0 24 24">
      <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 6h18" stroke-dasharray="2.5 2.5" />
        <path d="M8 6v12M16 6v12" />
      </g>
    </symbol>
    <symbol id="eip-architecture" viewBox="0 0 24 24">
      <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="7" height="10" />
        <rect x="14" y="3" width="7" height="18" />
        <path d="M10 16h4" />
      </g>
    </symbol>
    <symbol id="eip-integration" viewBox="0 0 24 24">
      <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="4.5" cy="12" r="2" />
        <rect x="9" y="8" width="6" height="8" />
        <circle cx="19.5" cy="12" r="2" />
        <path d="M6.5 12H9M15 12h2.5" />
      </g>
    </symbol>
    <symbol id="eip-ai-native" viewBox="0 0 24 24">
      <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3.5" />
        <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.2 2.2M16.2 16.2l2.2 2.2M18.4 5.6l-2.2 2.2M7.8 16.2l-2.2 2.2" />
      </g>
    </symbol>
  </defs>
</svg>

<style>
  .eip-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
