---
/**
 * Lámina de un proyecto: la imagen (captura real de un sitio público o esquema de
 * arquitectura) dentro de un marco de dibujo con marcas de esquina. Las capturas llevan
 * un pie en mono con su procedencia ("captura de runt.gov.co · 2026-10"); los esquemas
 * no llevan pie. En la galería va en modo `thumb`
 * (proporción fija, recorte superior); en la página de detalle, a tamaño completo.
 */
import { Image } from 'astro:assets';
import type { Project } from '@/lib/content';
import { t, type Locale } from '@/lib/i18n';
import Schematic from './Schematic.astro';

interface Props {
  project: Project;
  locale: Locale;
  mode?: 'thumb' | 'full';
  /** Qué dibujar: la captura si existe (por defecto) o el esquema. */
  show?: 'capture' | 'schematic';
  class?: string;
}

const { project, locale, mode = 'thumb', show, class: className } = Astro.props;
const tr = t(locale);
const { plate, schematic, title } = project.data;
const kind = show ?? (plate ? 'capture' : 'schematic');
const caption = kind === 'capture' && plate ? `${tr('work.captureOf')} ${plate.source} · ${plate.captured}` : null;
---

<figure class:list={['plate', `plate--${mode}`, `plate--${kind}`, className]}>
  <div class="plate-frame">
    {
      kind === 'capture' && plate ? (
        <Image
          src={plate.src}
          alt={plate.alt}
          widths={mode === 'thumb' ? [420, 640, 840] : [640, 960, 1280]}
          sizes={mode === 'thumb' ? '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw' : '(min-width: 960px) 760px, 100vw'}
          loading={mode === 'thumb' ? 'lazy' : 'eager'}
          decoding="async"
        />
      ) : (
        schematic && (
          <div class="plate-schematic">
            <Schematic columns={schematic.columns} edges={schematic.edges} title={`${title}: ${tr('work.schematic')}`} compact={mode === 'thumb'} />
          </div>
        )
      )
    }
  </div>
  {caption && mode === 'full' && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .plate {
    display: grid;
    gap: 0;
    margin: 0;
    min-width: 0;
  }

  /* Marco de la lámina: hairline con marcas de esquina, como una hoja en miniatura */
  .plate-frame {
    position: relative;
    overflow: hidden;
    border: var(--line-hair) solid var(--ink);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink)),
      radial-gradient(circle, var(--grid) 1px, transparent 1.5px);
    background-size:
      10px 2px,
      2px 10px,
      10px 2px,
      2px 10px,
      10px 2px,
      2px 10px,
      10px 2px,
      2px 10px,
      24px 24px;
    background-position:
      0 0,
      0 0,
      100% 0,
      100% 0,
      0 100%,
      0 100%,
      100% 100%,
      100% 100%,
      12px 12px;
    background-repeat: no-repeat, no-repeat, no-repeat, no-repeat, no-repeat, no-repeat, no-repeat, no-repeat, repeat;
  }

  .plate-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Miniatura: proporción fija; la captura se recorta por arriba, el esquema se centra */
  .plate--thumb .plate-frame {
    aspect-ratio: 16 / 10;
  }

  .plate--thumb.plate--capture .plate-frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .plate--thumb .plate-schematic {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 6%;
  }

  .plate--thumb .plate-schematic :global(svg) {
    max-height: 100%;
    width: auto;
    max-width: 100%;
  }

  /* Lámina completa: margen de hoja alrededor del esquema; la captura a sangre. En pantallas angostas el
     esquema conserva un ancho mínimo legible y se desplaza en horizontal (misma excepción que DETAIL A). */
  .plate--full .plate-schematic {
    padding: clamp(0.75rem, 3vw, 2rem);
    overflow-x: auto;
  }

  @media (max-width: 639px) {
    .plate--full .plate-schematic :global(svg) {
      min-width: 520px;
    }
  }

  .plate--full.plate--capture .plate-frame {
    border-width: var(--line);
  }

  figcaption {
    padding: var(--s-2) 0 0;
    font: 500 var(--text-mono-sm) / 1.3 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--graphite);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .plate--full figcaption {
    white-space: normal;
  }
</style>
