---
/**
 * Hoja 3 · Perfil longitudinal. La trayectoria como línea de tiempo sin fechas
 * y sin el detalle del CV: empresa, relación (`client`: contratista, cliente
 * final), cargo, un resumen de una línea (`short`) y un stack superficial (`tags`).
 *
 * El orden es el de `getExperience`: los puestos actuales primero (Avianca como
 * contratista, luego Quind) y después del más reciente al más antiguo. La línea
 * arranca en el bloque HOY y se aleja hacia el pasado.
 *
 * - Escritorio (≥ 960 px): horizontal, HOY a la izquierda; las estaciones
 *   alternan arriba y abajo de la línea, con su línea de llamada y su marcador
 *   (ámbar si el puesto es actual).
 * - Móvil y tablet (< 960 px): vertical, HOY arriba.
 *
 * El trabajo como contratista independiente (`type: freelance`) no se muestra
 * aquí: no es una estación de la trayectoria sino un frente permanente, y sus
 * proyectos viven en la hoja 4.
 */
import type { Experience } from '@/lib/content';
import { slugOf } from '@/lib/content';
import { t, type Locale } from '@/lib/i18n';
import Sheet from '../components/Sheet.astro';
import { vocabFor } from '../labels';

interface Props {
  experience: Experience[];
  locale: Locale;
  total: number;
}

const { experience, locale, total } = Astro.props;
const tr = t(locale);
const v = vocabFor(locale);

const stations = experience.filter((e) => e.data.type !== 'freelance');
/** Columnas de estaciones: una por estación más una para que la última tenga ancho. */
const cols = stations.length + 1;

const shortOf = (e: Experience) => e.data.short ?? e.data.summary;
const tagsOf = (e: Experience) => (e.data.tags.length ? e.data.tags : e.data.stack.slice(0, 4));
---

<Sheet id="experience" number={3} {total} title={tr('section.experience')} {locale} labelledby="experience-title">
  <h2 id="experience-title" class="sheet-title">{tr('section.experience')}</h2>

  <ol class="line" role="list" aria-label={v.timeline} data-today={v.today} style={`--cols: ${cols}`}>
    {
      stations.map((e, i) => (
        <li
          id={`experience-${slugOf(e)}`}
          class:list={['station', i % 2 ? 'below' : 'above', { 'is-current': e.data.end === null }]}
          style={`--i: ${i + 1}`}
        >
          <h3 class="company">{e.data.company}</h3>
          {e.data.client && <p class="client">{e.data.client}</p>}
          <p class="role">{e.data.role}</p>
          <p class="short">{shortOf(e)}</p>
          <p class="tags">{tagsOf(e).join(' · ')}</p>
        </li>
      ))
    }
  </ol>
</Sheet>

<style>
  .line {
    --mark: 12px;
    position: relative;
    color: var(--ink);
  }

  .company {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.005em;
    text-transform: uppercase;
  }

  .client {
    margin-top: 2px;
    font: 500 var(--text-mono-sm) / 1.3 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--graphite);
  }

  .role {
    margin-top: var(--s-1);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .short {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
    color: var(--graphite);
    max-width: 38ch;
  }

  .tags {
    margin-top: var(--s-2);
    font: 400 var(--text-mono-sm) / 1.4 var(--font-mono);
    color: var(--graphite);
    overflow-wrap: anywhere;
  }

  .station {
    position: relative;
  }

  /* Marcador de cada estación: círculo de tinta; ámbar si el puesto es actual */
  .station::after {
    content: '';
    position: absolute;
    width: var(--mark);
    height: var(--mark);
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
  }

  .is-current::after {
    background: var(--amber);
  }

  /* Línea de llamada entre el marcador y el texto */
  .station::before {
    content: '';
    position: absolute;
  }

  /* Bloque HOY: tinta sobre papel, como el bloque PROD de la ruta; es el origen de la línea */
  .line::after {
    content: attr(data-today);
    display: grid;
    place-items: center;
    padding: 6px 10px;
    background: var(--ink);
    color: var(--white);
    font: 700 0.875rem / 1 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------- Escritorio: horizontal, HOY a la izquierda ---------- */
  @media (min-width: 960px) {
    .line {
      display: grid;
      grid-template-columns: max-content repeat(var(--cols), minmax(0, 1fr));
      grid-template-rows: auto 56px auto;
      column-gap: 0;
    }

    /* La línea principal: trazo de 2 px a lo largo de la fila central; HOY la tapa en el origen */
    .line::before {
      content: '';
      grid-column: 1 / -1;
      grid-row: 2;
      align-self: center;
      height: 0;
      border-top: var(--line-strong) solid var(--ink);
    }

    .line::after {
      grid-column: 1;
      grid-row: 2;
      align-self: center;
      margin-right: var(--s-5);
    }

    .station {
      grid-column: calc(var(--i) + 1) / span 2;
      padding: 0 var(--s-4) 0 var(--s-3);
      min-width: 0;
    }

    .station.above {
      grid-row: 1;
      align-self: end;
      padding-bottom: var(--s-5);
    }

    .station.below {
      grid-row: 3;
      align-self: start;
      padding-top: var(--s-5);
    }

    /* Llamada: vertical, desde el texto hasta el centro de la línea (28 px dentro de la fila 2) */
    .station::before {
      left: 0;
      width: 0;
      height: calc(var(--s-5) + 28px);
      border-left: var(--line) solid var(--ink);
      transform: translateX(-50%);
    }

    .station.above::before {
      bottom: -28px;
    }

    .station.below::before {
      top: -28px;
    }

    .station::after {
      left: 0;
    }

    .station.above::after {
      bottom: -28px;
      transform: translate(-50%, 50%);
    }

    .station.below::after {
      top: -28px;
      transform: translate(-50%, -50%);
    }
  }

  /* ---------- Móvil y tablet: vertical, HOY arriba ---------- */
  @media (max-width: 959px) {
    .line {
      display: flex;
      flex-direction: column;
      gap: var(--s-5);
      padding: 44px 0 0 calc(var(--mark) + var(--s-5));
    }

    .line::before {
      content: '';
      position: absolute;
      left: calc(var(--mark) / 2);
      top: 28px;
      bottom: 0;
      width: 0;
      border-left: var(--line-strong) solid var(--ink);
      transform: translateX(-50%);
    }

    .line::after {
      position: absolute;
      left: 0;
      top: 0;
    }

    .station::before {
      left: calc(-1 * var(--s-5) - var(--mark) / 2);
      top: 8px;
      width: calc(var(--s-5) + var(--mark) / 2 - var(--s-2));
      height: 0;
      border-top: var(--line) solid var(--ink);
    }

    .station::after {
      left: calc(-1 * var(--s-5) - var(--mark) / 2);
      top: 8px;
      transform: translate(-50%, -50%);
    }
  }
</style>
