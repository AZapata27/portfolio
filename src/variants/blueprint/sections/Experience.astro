---
/**
 * Hoja 3 · Perfil longitudinal. La trayectoria como línea de tiempo, sin el
 * detalle del CV: empresa, cargo, un resumen de una línea (`short`) y un stack
 * superficial (`tags`).
 *
 * - Escritorio (≥ 960 px): horizontal, del primer empleo (izquierda) a hoy
 *   (derecha). Las estaciones alternan arriba y abajo de la línea, cada una con
 *   su línea de llamada y su marcador; los puestos actuales llevan el marcador
 *   en ámbar y la línea termina en el bloque HOY.
 * - Móvil y tablet (< 960 px): vertical, con lo más reciente arriba (HOY) y el
 *   pasado hacia abajo.
 *
 * El trabajo como contratista independiente (`type: freelance`) no es una
 * estación: corre en paralelo a todo lo demás, así que se dibuja como el
 * control bus (línea discontinua azul) desde la estación en que empieza hasta hoy.
 */
import type { Experience } from '@/lib/content';
import { slugOf } from '@/lib/content';
import { formatPeriod, t, type Locale } from '@/lib/i18n';
import Sheet from '../components/Sheet.astro';
import { vocabFor } from '../labels';

interface Props {
  experience: Experience[];
  locale: Locale;
  drawingName: string;
  total: number;
}

const { experience, locale, drawingName, total } = Astro.props;
const tr = t(locale);
const v = vocabFor(locale);

/** Orden cronológico por inicio; el DOM va del pasado a hoy. */
const chronological = [...experience].sort(
  (a, b) => a.data.start.localeCompare(b.data.start) || a.data.order - b.data.order,
);
const stations = chronological.filter((e) => e.data.type !== 'freelance');
const stationIndex = new Map(stations.map((e, i) => [e.id, i + 1]));
/** Columnas de la grilla: una por estación más una para que la última tenga ancho. */
const cols = stations.length + 1;

const shortOf = (e: Experience) => e.data.short ?? e.data.summary;
const tagsOf = (e: Experience) => (e.data.tags.length ? e.data.tags : e.data.stack.slice(0, 4));
/** Columna donde arranca una vía paralela: la primera estación que empieza después de ella. */
function startCol(e: Experience): number {
  const i = stations.findIndex((s) => s.data.start > e.data.start);
  return i === -1 ? stations.length : i + 1;
}
---

<Sheet id="experience" number={3} {total} title={v.profile} {drawingName} {locale} labelledby="experience-title">
  <h2 id="experience-title" class="sheet-title">{tr('section.experience')}</h2>

  <ol class="line" role="list" aria-label={v.timeline} data-today={v.today} style={`--cols: ${cols}`}>
    {
      chronological.map((e) => {
        const idx = stationIndex.get(e.id);
        const current = e.data.end === null;
        return idx ? (
          <li
            id={`experience-${slugOf(e)}`}
            class:list={['station', idx % 2 ? 'above' : 'below', { 'is-current': current }]}
            style={`--i: ${idx}`}
          >
            <time class="period">{formatPeriod(e.data.start, e.data.end, locale)}</time>
            <h3 class="company">{e.data.company}</h3>
            <p class="role">{e.data.role}</p>
            <p class="short">{shortOf(e)}</p>
            <p class="tags">{tagsOf(e).join(' · ')}</p>
          </li>
        ) : (
          <li
            id={`experience-${slugOf(e)}`}
            class:list={['parallel', { 'is-current': current }]}
            style={`--from: ${startCol(e)}`}
          >
            <div class="parallel-head">
              <span class="parallel-lbl">{v.parallel}</span>
              <time class="period">{formatPeriod(e.data.start, e.data.end, locale)}</time>
              <h3 class="company">{e.data.company}</h3>
              <p class="role">{e.data.role}</p>
            </div>
            <div class="parallel-body">
              <p class="short">{shortOf(e)}</p>
              <p class="tags">{tagsOf(e).join(' · ')}</p>
            </div>
          </li>
        );
      })
    }
  </ol>
</Sheet>

<style>
  .line {
    --mark: 12px;
    position: relative;
    color: var(--ink);
  }

  .period {
    display: block;
    font: 500 var(--text-mono-sm) / 1.3 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--graphite);
  }

  .company {
    margin-top: var(--s-1);
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.005em;
    text-transform: uppercase;
  }

  .role {
    margin-top: 2px;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .short {
    margin-top: var(--s-2);
    font-size: var(--text-sm);
    color: var(--graphite);
    max-width: 38ch;
  }

  .tags {
    margin-top: var(--s-2);
    font: 400 var(--text-mono-sm) / 1.4 var(--font-mono);
    color: var(--graphite);
    overflow-wrap: anywhere;
  }

  /* Marcador de cada estación: círculo de tinta; ámbar si el puesto es actual */
  .station::after,
  .parallel::after {
    content: '';
    position: absolute;
    width: var(--mark);
    height: var(--mark);
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
  }

  .is-current::after {
    background: var(--amber);
  }

  /* Línea de llamada entre el marcador y el texto */
  .station::before,
  .parallel::before {
    content: '';
    position: absolute;
  }

  .parallel::after {
    border-color: var(--blue);
  }

  .parallel-lbl {
    display: inline-block;
    margin-bottom: var(--s-1);
    font: 700 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--blue);
  }

  .parallel .company {
    color: var(--blue);
  }

  /* Bloque HOY: tinta sobre papel, como el bloque PROD de la ruta */
  .line::after {
    content: attr(data-today);
    display: grid;
    place-items: center;
    padding: 6px 10px;
    background: var(--ink);
    color: var(--white);
    font: 700 0.875rem / 1 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------- Escritorio: horizontal ---------- */
  @media (min-width: 960px) {
    .line {
      display: grid;
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      grid-template-rows: auto 56px auto auto;
      column-gap: 0;
      padding-left: calc(var(--mark) / 2);
    }

    /* La línea principal: trazo de 2 px a lo largo de la fila central */
    .line::before {
      content: '';
      grid-column: 1 / -1;
      grid-row: 2;
      align-self: center;
      height: 0;
      border-top: var(--line-strong) solid var(--ink);
    }

    .line::after {
      grid-column: -2 / -1;
      grid-row: 2;
      justify-self: end;
      align-self: center;
    }

    .station {
      position: relative;
      grid-column: var(--i) / span 2;
      padding: 0 var(--s-4) 0 var(--s-3);
      min-width: 0;
    }

    .station.above {
      grid-row: 1;
      align-self: end;
      padding-bottom: var(--s-5);
    }

    .station.below {
      grid-row: 3;
      align-self: start;
      padding-top: var(--s-5);
    }

    /* Llamada: vertical, desde el texto hasta el centro de la línea (28 px dentro de la fila 2) */
    .station::before {
      left: 0;
      width: 0;
      height: calc(var(--s-5) + 28px);
      border-left: var(--line) solid var(--ink);
      transform: translateX(-50%);
    }

    .station.above::before {
      bottom: -28px;
    }

    .station.below::before {
      top: -28px;
    }

    .station::after {
      left: 0;
    }

    .station.above::after {
      bottom: -28px;
      transform: translate(-50%, 50%);
    }

    .station.below::after {
      top: -28px;
      transform: translate(-50%, -50%);
    }

    /* Vía paralela: línea discontinua azul bajo las estaciones, desde su inicio hasta hoy */
    .parallel {
      position: relative;
      grid-column: var(--from) / -1;
      grid-row: 4;
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      gap: var(--s-2) var(--s-6);
      align-items: start;
      margin-top: var(--s-5);
      padding: var(--s-4) var(--s-4) 0 var(--s-3);
      border-top: var(--line) dashed var(--blue);
    }

    .parallel::before {
      display: none;
    }

    .parallel::after {
      left: 0;
      top: 0;
      transform: translate(-50%, -50%);
    }

    .parallel .short {
      margin-top: 0;
      max-width: 60ch;
    }

    .parallel .tags {
      margin-top: var(--s-1);
    }
  }

  /* ---------- Móvil y tablet: vertical, lo más reciente arriba ---------- */
  @media (max-width: 959px) {
    .line {
      display: flex;
      flex-direction: column-reverse;
      gap: var(--s-5);
      padding: 44px 0 0 calc(var(--mark) + var(--s-5));
    }

    .line::before {
      content: '';
      position: absolute;
      left: calc(var(--mark) / 2);
      top: 28px;
      bottom: 0;
      width: 0;
      border-left: var(--line-strong) solid var(--ink);
      transform: translateX(-50%);
    }

    .line::after {
      position: absolute;
      left: 0;
      top: 0;
    }

    .station,
    .parallel {
      position: relative;
    }

    .station::before,
    .parallel::before {
      left: calc(-1 * var(--s-5) - var(--mark) / 2);
      top: 8px;
      width: calc(var(--s-5) + var(--mark) / 2 - var(--s-2));
      height: 0;
      border-top: var(--line) solid var(--ink);
    }

    .station::after,
    .parallel::after {
      left: calc(-1 * var(--s-5) - var(--mark) / 2);
      top: 8px;
      transform: translate(-50%, -50%);
    }

    .parallel {
      padding: var(--s-3) var(--s-4);
      border: var(--line) dashed var(--blue);
    }

    .parallel::before {
      border-top-color: var(--blue);
      border-top-style: dashed;
    }

    .parallel-body {
      margin-top: var(--s-2);
    }
  }
</style>
