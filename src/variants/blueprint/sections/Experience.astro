---
/**
 * Hoja 3 · Revisiones. La experiencia como tabla REV / FECHA / DESCRIPCIÓN:
 * la revisión más alta es el puesto actual. En móvil cada fila se apila.
 */
import { render } from 'astro:content';
import type { Experience } from '@/lib/content';
import { slugOf } from '@/lib/content';
import { formatDuration, formatPeriod, t, type Locale } from '@/lib/i18n';
import Sheet from '../components/Sheet.astro';
import { pad2, vocabFor } from '../labels';

interface Props {
  experience: Experience[];
  locale: Locale;
  drawingName: string;
  total: number;
}

const { experience, locale, drawingName, total } = Astro.props;
const tr = t(locale);
const v = vocabFor(locale);
const rows = await Promise.all(
  experience.map(async (e) => ({ e, Content: (await render(e)).Content })),
);
const count = rows.length;
---

<Sheet id="experience" number={3} {total} title={v.revisions} {drawingName} {locale} labelledby="experience-title">
  <h2 id="experience-title" class="sheet-title">{tr('section.experience')}</h2>

  <table class="tbl revs">
    <caption>{v.revisions}</caption>
    <thead>
      <tr>
        <th scope="col">{v.rev}</th>
        <th scope="col">{v.date}</th>
        <th scope="col">{v.description}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ e, Content }, i) => (
          <tr id={`experience-${slugOf(e)}`} class:list={{ 'is-current': e.data.end === null }}>
            <td class="rev" data-label={v.rev}>
              {pad2(count - i)}
            </td>
            <td class="date" data-label={v.date}>
              <time>{formatPeriod(e.data.start, e.data.end, locale)}</time>
              <span class="dur">{formatDuration(e.data.start, e.data.end, locale)}</span>
            </td>
            <td class="desc" data-label={v.description}>
              <h3>{e.data.role}</h3>
              <p class="org">
                <span class="company">{e.data.company}</span>
                {e.data.client && <span class="client"> · {e.data.client}</span>}
              </p>
              <p class="sum">{e.data.summary}</p>
              <div class="ach">
                <Content />
              </div>
              {e.data.stack.length > 0 && <p class="stack">{e.data.stack.join(' · ')}</p>}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Sheet>

<style>
  .revs th,
  .revs td {
    padding: var(--s-4);
  }

  .rev {
    width: 4.5rem;
    font-weight: 700;
    color: var(--ink);
  }

  .is-current .rev {
    background: var(--amber);
  }

  .date {
    width: 12rem;
    white-space: nowrap;
  }

  .date time,
  .dur {
    display: block;
  }

  .dur {
    margin-top: 2px;
    color: var(--graphite);
  }

  .desc {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .desc h3 {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-transform: uppercase;
  }

  .org {
    margin-top: 2px;
    font-weight: 500;
  }

  .client {
    color: var(--graphite);
    font-weight: 400;
  }

  .sum {
    margin-top: var(--s-3);
    max-width: 62ch;
  }

  .ach {
    margin-top: var(--s-3);
    max-width: 66ch;
    font-size: var(--text-sm);
  }

  .ach :global(ul) {
    margin: 0;
    padding-left: 1.1em;
    list-style: square;
  }

  .ach :global(li) {
    padding-left: 0.2em;
  }

  .ach :global(li + li) {
    margin-top: var(--s-1);
  }

  .ach :global(li::marker) {
    color: var(--ink);
  }

  .ach :global(p) {
    margin: 0;
  }

  .stack {
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: var(--line-hair) solid var(--hair);
    font: 400 var(--text-mono-sm) / 1.5 var(--font-mono);
    color: var(--graphite);
  }

  @media (max-width: 899px) {
    .revs,
    .revs caption,
    .revs tbody,
    .revs tr,
    .revs th,
    .revs td {
      display: block;
    }

    .revs caption {
      width: 100%;
    }

    .revs thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .revs tr {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--s-3) var(--s-4);
      padding: var(--s-4);
    }

    .revs tr + tr {
      border-top: var(--line) solid var(--ink);
    }

    .revs th,
    .revs td {
      width: auto;
      padding: 0;
      border: 0;
    }

    .rev {
      grid-column: 1;
      grid-row: 1;
      padding: 2px 6px;
      border: var(--line-hair) solid var(--ink);
      align-self: start;
    }

    .date {
      grid-column: 2;
      grid-row: 1;
      white-space: normal;
    }

    .desc {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
