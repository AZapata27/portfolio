---
/**
 * Pie: nombre y año, crédito con enlace al código fuente y cambio de idioma.
 */
import type { Profile } from '@/lib/content';
import { homePath, otherLocale, t, type Locale } from '@/lib/i18n';

interface Props {
  profile: Profile;
  locale: Locale;
}

const { profile, locale } = Astro.props;
const tr = t(locale);
const other = otherLocale(locale);
const github = profile.links.find((l) => l.icon === 'github')?.url.replace(/\/$/, '');
const repo = github ? `${github}/portfolio` : undefined;
const year = new Date().getFullYear();
---

<footer class="foot">
  <p class="mono">
    <span>{profile.name} · {year}</span>
  </p>
  <p>
    {repo ? <a href={repo} target="_blank" rel="noopener">{tr('footer.built')}</a> : tr('footer.built')}
  </p>
  <a class="lang" href={homePath(other)} hreflang={other} lang={other}>
    {tr('lang.switch')}
  </a>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    width: 100%;
    max-width: var(--sheet-max);
    margin: var(--s-6) auto var(--s-8);
    padding: var(--s-4) var(--gutter) 0;
    border-top: var(--line) solid var(--ink);
    font: 400 var(--text-mono-sm) / 1.5 var(--font-mono);
    color: var(--graphite);
  }

  .mono {
    color: var(--graphite);
  }

  .lang {
    color: var(--blue);
  }

  @media (min-width: 1360px) {
    .foot {
      padding-inline: 0;
    }
  }
</style>
