---
/**
 * Hoja 4 · Detalles. Es la hoja con más peso del plano: cada proyecto tangible
 * es un detalle numerado (B en adelante; A es el código de la hoja 1), agrupado
 * por dominio (`domain`) en el orden en que aparece cada dominio. Los proyectos
 * con `metric` llevan su cifra como cota y un marco más grueso.
 */
import { render } from 'astro:content';
import type { Project } from '@/lib/content';
import { groupProjects, slugOf } from '@/lib/content';
import { t, type Locale } from '@/lib/i18n';
import Icon from '@/components/Icon.astro';
import Sheet from '../components/Sheet.astro';
import { slugify, vocabFor } from '../labels';

interface Props {
  projects: Project[];
  locale: Locale;
  drawingName: string;
  total: number;
}

const { projects, locale, drawingName, total } = Astro.props;
const tr = t(locale);
const v = vocabFor(locale);

const letterOf = new Map(projects.map((p, i) => [p.id, String.fromCharCode('B'.charCodeAt(0) + i)]));
const groups = await Promise.all(
  groupProjects(projects).map(async (g) => {
    const first = letterOf.get(g.items[0]!.id);
    const last = letterOf.get(g.items[g.items.length - 1]!.id);
    return {
      domain: g.domain,
      id: `work-${slugify(g.domain)}`,
      range: g.items.length === 1 ? first : `${first}–${last}`,
      items: await Promise.all(
        g.items.map(async (p) => ({ p, Content: (await render(p)).Content, letter: letterOf.get(p.id) })),
      ),
    };
  }),
);
---

<Sheet id="work" number={4} {total} title={v.details} {drawingName} {locale} labelledby="work-title">
  <h2 id="work-title" class="sheet-title">{tr('section.work')}</h2>

  {
    groups.map((g) => (
      <section class="group" aria-labelledby={g.id}>
        <h3 class="group-title" id={g.id}>
          <span class="group-range">
            {v.details} {g.range}
          </span>
          <span class="group-name">{g.domain}</span>
          <span class="group-count" aria-hidden="true">
            {g.items.length}
          </span>
        </h3>

        <div class="details">
          {g.items.map(({ p, Content, letter }) => (
            <article
              class:list={['detail', { 'detail--featured': Boolean(p.data.metric) }]}
              id={`work-${slugOf(p)}`}
              aria-labelledby={`work-${slugOf(p)}-title`}
            >
              <div class="detail-head">
                <span class="tag">
                  {v.detail} {letter}
                </span>
                <h4 id={`work-${slugOf(p)}-title`}>{p.data.title}</h4>
              </div>
              {p.data.metric && (
                <p class="cota">
                  <span class="cota-val">{p.data.metric.value}</span>
                  <span class="cota-lbl">{p.data.metric.label}</span>
                </p>
              )}
              <dl class="meta">
                <div>
                  <dt>{v.client}</dt>
                  <dd>{p.data.client}</dd>
                </div>
                <div>
                  <dt>{v.period}</dt>
                  <dd>{p.data.period}</dd>
                </div>
                <div>
                  <dt>{v.role}</dt>
                  <dd>{p.data.role}</dd>
                </div>
              </dl>
              <p class="sum">{p.data.summary}</p>
              <div class="body">
                <Content />
              </div>
              <p class="stack">{p.data.stack.join(' · ')}</p>
              {p.data.url && (
                <a class="ext" href={p.data.url} target="_blank" rel="noopener">
                  {v.openLink}
                  <Icon name="arrow-up-right" size={16} />
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    ))
  }
</Sheet>

<style>
  .group + .group {
    margin-top: var(--s-7);
  }

  /* Título de grupo: rango de detalles en mono, nombre del dominio en display, cantidad a la derecha */
  .group-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-4);
    border-bottom: var(--line-hair) solid var(--ink);
  }

  .group-range {
    font: 700 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  .group-name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .group-count {
    margin-left: auto;
    font: 500 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    color: var(--graphite);
  }

  .details {
    display: grid;
    gap: var(--s-4);
  }

  .detail {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding: var(--s-5);
    border: var(--line-hair) solid var(--ink);
    background: var(--paper);
    min-width: 0;
  }

  .detail--featured {
    border-width: var(--line);
  }

  /* Etiqueta DETALLE x sobre el título: las tarjetas son angostas y el título necesita todo el ancho */
  .detail-head {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
  }

  .tag {
    padding: 6px 8px;
    border: var(--line) solid var(--ink);
    font: 700 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    white-space: nowrap;
  }

  h4 {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.005em;
    text-transform: uppercase;
  }

  /* Cota: la cifra del proyecto como línea de dimensión con extremos */
  .cota {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: var(--s-3);
    margin: 0;
  }

  .cota::before,
  .cota::after {
    content: '';
    grid-row: 1;
    height: 14px;
    background-image:
      linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink));
    background-repeat: no-repeat;
  }

  .cota::before {
    grid-column: 1;
    background-size:
      var(--line) 14px,
      100% var(--line);
    background-position:
      left center,
      center;
  }

  .cota::after {
    grid-column: 3;
    background-size:
      var(--line) 14px,
      100% var(--line);
    background-position:
      right center,
      center;
  }

  .cota-val {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cota-lbl {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: var(--s-1);
    text-align: center;
    font: 400 var(--text-mono-sm) / 1.4 var(--font-mono);
    color: var(--graphite);
  }

  .meta {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    font: 400 var(--text-mono-sm) / 1.4 var(--font-mono);
  }

  .meta dt {
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  .meta dd {
    margin: 0;
    color: var(--ink);
  }

  .sum {
    font-size: var(--text-sm);
    font-weight: 500;
    max-width: 62ch;
  }

  .body {
    max-width: 66ch;
    font-size: var(--text-sm);
    color: var(--graphite);
  }

  .body :global(p) {
    margin: 0;
  }

  .body :global(p + p) {
    margin-top: var(--s-2);
  }

  .stack {
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: var(--line-hair) solid var(--hair);
    font: 400 var(--text-mono-sm) / 1.5 var(--font-mono);
    color: var(--graphite);
  }

  .ext {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    justify-self: start;
    font: 500 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  @media (max-width: 639px) {
    .detail {
      padding: var(--s-4);
    }
  }

  /* Tantas columnas como quepan de 272 px: cuatro en la hoja completa, así un grupo de cuatro va en una fila */
  @media (min-width: 640px) {
    .details {
      grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
    }
  }
</style>
