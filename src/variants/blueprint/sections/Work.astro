---
/**
 * Hoja 4 · Detalles. Cada proyecto es un detalle numerado (B en adelante; A es
 * el código de la hoja 1). Los destacados llevan su cifra como cota; los demás van
 * en una fila más compacta debajo.
 */
import { render } from 'astro:content';
import type { Project } from '@/lib/content';
import { slugOf } from '@/lib/content';
import { t, type Locale } from '@/lib/i18n';
import Icon from '@/components/Icon.astro';
import Sheet from '../components/Sheet.astro';
import { vocabFor } from '../labels';

interface Props {
  projects: Project[];
  locale: Locale;
  drawingName: string;
  total: number;
}

const { projects, locale, drawingName, total } = Astro.props;
const tr = t(locale);
const v = vocabFor(locale);

const items = await Promise.all(
  projects.map(async (p, i) => ({
    p,
    Content: (await render(p)).Content,
    letter: String.fromCharCode('B'.charCodeAt(0) + i),
  })),
);
const featured = items.filter((it) => it.p.data.featured);
const minor = items.filter((it) => !it.p.data.featured);
---

<Sheet id="work" number={4} {total} title={v.details} {drawingName} {locale} labelledby="work-title">
  <h2 id="work-title" class="sheet-title">{tr('section.work')}</h2>

  <div class="details">
    {
      featured.map(({ p, Content, letter }) => (
        <article class="detail" id={`work-${slugOf(p)}`} aria-labelledby={`work-${slugOf(p)}-title`}>
          <div class="detail-head">
            <span class="tag">
              {v.detail} {letter}
            </span>
            <h3 id={`work-${slugOf(p)}-title`}>{p.data.title}</h3>
          </div>
          {p.data.metric && (
            <p class="cota">
              <span class="cota-val">{p.data.metric.value}</span>
              <span class="cota-lbl">{p.data.metric.label}</span>
            </p>
          )}
          <dl class="meta">
            <div>
              <dt>{v.client}</dt>
              <dd>{p.data.client}</dd>
            </div>
            <div>
              <dt>{v.period}</dt>
              <dd>{p.data.period}</dd>
            </div>
            <div>
              <dt>{v.domain}</dt>
              <dd>{p.data.domain}</dd>
            </div>
            <div>
              <dt>{v.role}</dt>
              <dd>{p.data.role}</dd>
            </div>
          </dl>
          <p class="sum">{p.data.summary}</p>
          <div class="body">
            <Content />
          </div>
          <p class="stack">{p.data.stack.join(' · ')}</p>
          {p.data.url && (
            <a class="ext" href={p.data.url} target="_blank" rel="noopener">
              {v.openLink}
              <Icon name="arrow-up-right" size={16} />
            </a>
          )}
        </article>
      ))
    }
  </div>

  {
    minor.length > 0 && (
      <div class="details details--minor">
        {minor.map(({ p, Content, letter }) => (
          <article class="detail detail--minor" id={`work-${slugOf(p)}`} aria-labelledby={`work-${slugOf(p)}-title`}>
            <div class="detail-head">
              <span class="tag">
                {v.detail} {letter}
              </span>
              <h3 id={`work-${slugOf(p)}-title`}>{p.data.title}</h3>
            </div>
            <dl class="meta">
              <div>
                <dt>{v.client}</dt>
                <dd>{p.data.client}</dd>
              </div>
              <div>
                <dt>{v.period}</dt>
                <dd>{p.data.period}</dd>
              </div>
            </dl>
            <p class="sum">{p.data.summary}</p>
            <div class="body">
              <Content />
            </div>
            <p class="stack">{p.data.stack.join(' · ')}</p>
            {p.data.url && (
              <a class="ext" href={p.data.url} target="_blank" rel="noopener">
                {v.openLink}
                <Icon name="arrow-up-right" size={16} />
              </a>
            )}
          </article>
        ))}
      </div>
    )
  }
</Sheet>

<style>
  .details {
    display: grid;
    gap: var(--s-5);
  }

  .details--minor {
    margin-top: var(--s-6);
  }

  .detail {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding: var(--s-5);
    border: var(--line) solid var(--ink);
    background: var(--paper);
    min-width: 0;
  }

  .detail--minor {
    padding: var(--s-4) var(--s-5);
    border-width: var(--line-hair);
  }

  .detail-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
  }

  .tag {
    padding: 6px 8px;
    border: var(--line) solid var(--ink);
    font: 700 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    white-space: nowrap;
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    padding-top: 0.15rem;
  }

  .detail--minor h3 {
    font-size: var(--text-h4);
    line-height: 1.05;
  }

  /* Cota: la cifra del proyecto como línea de dimensión con extremos */
  .cota {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: var(--s-3);
    margin: var(--s-2) 0 0;
  }

  .cota::before,
  .cota::after {
    content: '';
    grid-row: 1;
    height: 14px;
    background-image:
      linear-gradient(var(--ink), var(--ink)),
      linear-gradient(var(--ink), var(--ink));
    background-repeat: no-repeat;
  }

  .cota::before {
    grid-column: 1;
    background-size:
      var(--line) 14px,
      100% var(--line);
    background-position:
      left center,
      center;
  }

  .cota::after {
    grid-column: 3;
    background-size:
      var(--line) 14px,
      100% var(--line);
    background-position:
      right center,
      center;
  }

  .cota-val {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cota-lbl {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: var(--s-1);
    text-align: center;
    font: 400 var(--text-mono-sm) / 1.4 var(--font-mono);
    color: var(--graphite);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2) var(--s-4);
    margin: 0;
    font: 400 var(--text-mono-sm) / 1.4 var(--font-mono);
  }

  .meta dt {
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  .meta dd {
    margin: 0;
    color: var(--ink);
  }

  .sum {
    font-weight: 500;
    max-width: 62ch;
  }

  .body {
    max-width: 66ch;
    font-size: var(--text-sm);
  }

  .body :global(p) {
    margin: 0;
  }

  .body :global(p + p) {
    margin-top: var(--s-2);
  }

  .stack {
    padding-top: var(--s-3);
    border-top: var(--line-hair) solid var(--hair);
    font: 400 var(--text-mono-sm) / 1.5 var(--font-mono);
    color: var(--graphite);
  }

  .ext {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    justify-self: start;
    font: 500 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  @media (max-width: 639px) {
    .detail-head {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }

    .tag {
      justify-self: start;
    }

    h3 {
      font-size: var(--text-h4);
      line-height: 1.05;
    }
  }

  @media (min-width: 900px) {
    .details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .details--minor {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
