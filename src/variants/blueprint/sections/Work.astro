---
/**
 * Hoja 4 · Detalles. La hoja con más peso del plano, como galería de láminas:
 * cada proyecto es una lámina (captura real o esquema de arquitectura) con
 * título, cliente y una línea, agrupada por dominio. Sin numeración ni pies:
 * toda la lámina es el enlace y el feedback es el hover. El texto
 * largo vive en la página de detalle (`/proyectos/<slug>/`), a la que lleva toda
 * la lámina. Los proyectos con cifra la llevan como sello en la esquina.
 */
import type { Project } from '@/lib/content';
import { groupProjects, slugOf } from '@/lib/content';
import { projectPath, t, type Locale } from '@/lib/i18n';
import Icon from '@/components/Icon.astro';
import Sheet from '../components/Sheet.astro';
import Plate from '../components/Plate.astro';
import { slugify } from '../labels';

interface Props {
  projects: Project[];
  locale: Locale;
  total: number;
}

const { projects, locale, total } = Astro.props;
const tr = t(locale);

const groups = groupProjects(projects).map((g) => ({
  domain: g.domain,
  id: `work-${slugify(g.domain)}`,
  items: g.items,
}));
---

<Sheet id="work" number={4} {total} title={tr('section.work')} {locale} labelledby="work-title">
  <h2 id="work-title" class="sheet-title">
    {tr('section.work')}
    <span class="count">{projects.length} {tr('work.count')}</span>
  </h2>

  {
    groups.map((g) => (
      <section class="group" aria-labelledby={g.id}>
        <h3 class="group-title" id={g.id}>
          <span class="group-name">{g.domain}</span>
          <span class="group-count" aria-hidden="true">
            {g.items.length} {tr('work.count')}
          </span>
        </h3>

        <ul class="gallery" role="list">
          {g.items.map((p) => (
            <li>
              <a class="card" href={projectPath(locale, slugOf(p))} id={`work-${slugOf(p)}`}>
                <div class="card-plate">
                  <Plate project={p} {locale} mode="thumb" />
                  {p.data.metric && <span class="seal">{p.data.metric.value}</span>}
                </div>
                <div class="card-body">
                  <h4>{p.data.title}</h4>
                  <p class="meta">
                    {p.data.client} · {p.data.period}
                  </p>
                  <p class="sum">{p.data.summary}</p>
                  <span class="open">
                    {tr('work.open')}
                    <Icon name="arrow-right" size={16} />
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Sheet>

<style>
  .sheet-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-5);
  }

  .count {
    font: 500 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  .group + .group {
    margin-top: var(--s-7);
  }

  /* Título de grupo: nombre del dominio en display, cantidad a la derecha */
  .group-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-5);
    border-bottom: var(--line-hair) solid var(--ink);
  }

  .group-name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .group-count {
    margin-left: auto;
    font: 500 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    color: var(--graphite);
  }

  .gallery {
    display: grid;
    gap: var(--s-6) var(--s-5);
  }

  /* Toda la lámina es el enlace: sin subrayado, el énfasis es el trazo */
  .card {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
  }

  .card-plate {
    position: relative;
  }

  .card-plate :global(.plate-frame) {
    transition: box-shadow var(--d-fast) var(--ease-out);
  }

  /* Hover: el marco engrosa a 2 px, el título se subraya y la acción se rellena de ámbar */
  .card:hover .card-plate :global(.plate-frame),
  .card:focus-visible .card-plate :global(.plate-frame) {
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .card:hover h4,
  .card:focus-visible h4 {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.12em;
  }

  /* Sello con la cifra: ámbar sobre la esquina de la lámina, como una etiqueta pegada */
  .seal {
    position: absolute;
    right: -1px;
    top: -1px;
    padding: 6px 10px;
    border: var(--line) solid var(--ink);
    background: var(--amber);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .card-body {
    display: grid;
    gap: var(--s-2);
    min-width: 0;
  }

  h4 {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .meta {
    font: 400 var(--text-mono-sm) / 1.4 var(--font-mono);
    color: var(--graphite);
  }

  .sum {
    font-size: var(--text-sm);
    color: var(--graphite);
    max-width: 48ch;
  }

  .open {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    justify-self: start;
    margin-top: var(--s-1);
    padding: 6px 8px;
    border: var(--line-hair) solid var(--ink);
    font: 500 var(--text-mono-sm) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink);
    transition: background-color var(--d-fast) var(--ease-out);
  }

  .open :global(svg) {
    transition: transform var(--d-fast) var(--ease-out);
  }

  .card:hover .open,
  .card:focus-visible .open {
    background: var(--amber);
  }

  .card:hover .open :global(svg),
  .card:focus-visible .open :global(svg) {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .open :global(svg) {
      transform: none;
    }
  }

  @media (min-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
